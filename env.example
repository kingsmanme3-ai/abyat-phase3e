# انسخ هذا الملف إلى .env وعدّل القيم
HTTP_PORT=8080
POSTGRES_DB=abyat
POSTGRES_USER=abyat
POSTGRES_PASSWORD=change-me
# مفتاح التوقيع: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_FULL_NAME=مدير النظام

# فرق التوقيت عن UTC لحساب «اليوم» في اللقطات اليومية (اختياري، الافتراضي 3 = السعودية)
TZ_OFFSET_HOURS=3

# ---- المرحلة 3 (كلها اختيارية) ----
# مدة الاحتفاظ بالتقارير المولّدة بالأيام
# REPORTS_KEEP_DAYS=90
# إرسال التقارير المجدولة بالبريد: فعّل الأسطر التالية واملأها (اتركها معلّقة لتعطيل الإرسال)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=
# SMTP_FROM=abyat@example.com
# SMTP_STARTTLS=true

# ---- المرحلة 3ج (كلها اختيارية) ----
# ترويسة ملف PDF القياسي للتقارير
# COMPANY_NAME=شركة أسوار بلس العقارية
# COMPANY_SUBTITLE=للشقق المخدومة والفنادق
# أقصى حجم للصورة والفيديو بالميغابايت
# MAX_IMAGE_MB=15
# MAX_VIDEO_MB=150

